# ---- Server configuration for the Hitch & Haul trailer rental site ----

# JWT_SECRET: Secret used to sign admin login tokens. Change this to a long
# random string in production. If not set, a development default is used.
JWT_SECRET="change-me-to-a-long-random-string"

# PORT: Which port the combined server (backend API + built frontend) listens on.
# The Vite dev server uses 3000; this server defaults to 3001.
PORT=3001

# -------- Admin & email are configured through the web admin panel at /admin ----
# 1. Open the site, click "Admin" in the nav, and run first-time setup (set a password).
# 2. In Settings, configure SMTP email so the owner is notified on each new booking.
#    (e.g. Gmail app password, Zoho, Outlook SMTP, etc.)
# No secret keys are required here to get started.
